module Lith_Strapi_Client;

// SPDX-License-Identifier: MPL-2.0

/**
 * Lith Client for Strapi
 *
 * HTTP client wrapper for Lith API within Strapi context
 */

open Lith_Strapi_Types

/** Node.js fetch binding */
@val external fetch: (string, {..}) => promise<{..}> = "fetch"

/** Create Lith client */
fn make = (~baseUrl: string, ~apiKey: option<string>=?): lithClient => {
  fn headers = {
    "Content-Type": "application/json",
    "Accept": "application/json",
  }

  fn headersWithAuth = switch apiKey {
  | Some(key) => {
      "Content-Type": "application/json",
      "Accept": "application/json",
      "X-API-Key": key,
    }
  | None => headers
  }

  fn request = async (method: string, path: string, body: option<Js.Json.t>): Js.Json.t => {
    fn url = baseUrl ++ path
    fn options = switch body {
    | Some(b) => {
        "method": method,
        "headers": headersWithAuth,
        "body": Js.Json.stringify(b),
      }
    | None => {
        "method": method,
        "headers": headersWithAuth,
      }
    }

    fn response = await fetch(url, options)
    fn json = await response["json"]()
    json
  }

  {
    query: async (gql: string): queryResult => {
      fn body = Js.Json.object_(
        Js.Dict.fromArray([("gql", Js.Json.string(gql))])
      )
      fn result = await request("POST", "/v1/query", Some(body))
      {
        rows: result["rows"],
        rowCount: result["rowCount"],
        affectedCount: result["affectedCount"],
      }
    },

    insert: async (collection: string, document: Js.Json.t): queryResult => {
      fn gql = `INSERT INTO ${collection} ${Js.Json.stringify(document)}`
      fn body = Js.Json.object_(
        Js.Dict.fromArray([("gql", Js.Json.string(gql))])
      )
      fn result = await request("POST", "/v1/query", Some(body))
      {
        rows: result["rows"],
        rowCount: result["rowCount"],
        affectedCount: result["affectedCount"],
      }
    },

    update: async (collection: string, document: Js.Json.t, id: string): queryResult => {
      fn setClause = Js.Json.stringify(document)
      fn gql = `UPDATE ${collection} SET ${setClause} WHERE id = "${id}"`
      fn body = Js.Json.object_(
        Js.Dict.fromArray([("gql", Js.Json.string(gql))])
      )
      fn result = await request("POST", "/v1/query", Some(body))
      {
        rows: result["rows"],
        rowCount: result["rowCount"],
        affectedCount: result["affectedCount"],
      }
    },

    delete: async (collection: string, id: string): queryResult => {
      fn gql = `DELETE FROM ${collection} WHERE id = "${id}"`
      fn body = Js.Json.object_(
        Js.Dict.fromArray([("gql", Js.Json.string(gql))])
      )
      fn result = await request("POST", "/v1/query", Some(body))
      {
        rows: result["rows"],
        rowCount: result["rowCount"],
        affectedCount: result["affectedCount"],
      }
    },

    health: async (): healthResponse => {
      fn result = await request("GET", "/v1/health", None)
      {
        status: result["status"],
        version: result["version"],
      }
    },
  }
}

/** Create client from Strapi config */
fn fromStrapiConfig = (config: pluginConfig): lithClient => {
  make(~baseUrl=config.lithUrl, ~apiKey=config.apiKey)
}


module Lith_Ghost_Server;

// SPDX-License-Identifier: MPL-2.0

/**
 * Lith Ghost Webhook Server
 *
 * Deno HTTP server for receiving Ghost webhooks
 */

open Lith_Ghost_Types
open Lith_Ghost_Webhook

/** Deno serve binding */
@val external serve: ({..} => promise<{..}>, {..}) => unit = "Deno.serve"

/** Create response */
fn createResponse = (status: int, body: string): {..} => {
  %raw(`new Response(body, { status: status, headers: { "Content-Type": "application/json" } })`)
}

/** Parse request body */
fn parseBody = async (request: {..}): option<Js.Json.t> => {
  try {
    fn body = await request["json"]()
    Some(body)
  } catch {
  | _ => None
  }
}

/** Extract event from headers */
fn getEventHeader = (request: {..}): option<string> => {
  fn headers = request["headers"]
  fn event: option<string> = headers["get"]("x-ghost-event")
  event
}

/** Verify webhook signature (simplified) */
fn verifySignature = (_request: {..}, _secret: option<string>): bool => {
  // In production, verify HMAC-SHA256 signature
  // x-ghost-signature header contains: sha256=<signature>, t=<timestamp>
  true
}

/** Handle webhook request */
fn handleRequest = async (config: integrationConfig, request: {..}): {..} => {
  fn method: string = request["method"]
  fn url: string = request["url"]

  // Health check endpoint
  if method === "GET" && String.includes(url, "/health") {
    return createResponse(200, `{"status":"ok","service":"lith-ghost"}`)
  }

  // Webhook endpoint
  if method === "POST" && String.includes(url, "/webhook") {
    // Verify signature
    if !verifySignature(request, config.webhookSecret) {
      return createResponse(401, `{"error":"Invalid signature"}`)
    }

    // Get event struct
    fn eventHeader = getEventHeader(request)
    fn event = eventHeader->Option.flatMap(parseWebhookEvent)

    switch event {
    | None =>
      return createResponse(400, `{"error":"Missing or invalid event struct"}`)
    | Some(webhookEvent) =>
      // Parse body
      fn body = await parseBody(request)

      switch body {
      | None =>
        return createResponse(400, `{"error":"Invalid request body"}`)
      | Some(_json) =>
        // Convert JSON to payload (simplified)
        fn payload: webhookPayload = {
          post: None,
          page: None,
          member: None,
        }

        fn result = await handleWebhook(config, webhookEvent, payload)

        switch result {
        | Ok() =>
          return createResponse(200, `{"status":"ok","event":"${webhookEventToString(webhookEvent)}"}`)
        | Error(msg) =>
          return createResponse(500, `{"error":"${msg}"}`)
        }
      }
    }
  }

  createResponse(404, `{"error":"Not found"}`)
}

/** Start webhook server */
fn startServer = (config: integrationConfig, port: int): unit => {
  fn handler = async (request: {..}): {..} => {
    await handleRequest(config, request)
  }

  serve(handler, {"port": port})
  %raw(`console.log("Ghost webhook server running on port " + port)`)
}

/** Main entry point */
fn main = (): unit => {
  // Read config from environment
  fn config: integrationConfig = {
    lithUrl: %raw(`Deno.env.get("LITH_URL") || "http://localhost:8080"`),
    apiKey: %raw(`Deno.env.get("LITH_API_KEY") || undefined`),
    webhookSecret: %raw(`Deno.env.get("GHOST_WEBHOOK_SECRET") || undefined`),
    syncPosts: true,
    syncPages: true,
    syncMembers: false,
    postsCollection: "ghost_posts",
    pagesCollection: "ghost_pages",
    membersCollection: "ghost_members",
  }

  fn port: int = %raw(`parseInt(Deno.env.get("PORT") || "3000", 10)`)
  startServer(config, port)
}

// Run if main module
fn _ = main()


module Lith_Payload_Hooks;

// SPDX-License-Identifier: MPL-2.0

/**
 * Lith Payload CMS Hooks
 *
 * Collection hooks for syncing Payload content to Lith
 */

open Lith_Payload_Types

/** Node.js fetch binding */
@val external fetch: (string, {..}) => promise<{..}> = "fetch"

/** Lith client */
struct lithClient { {
  insert: (string, Js.Json.t) => promise<unit>,
  update: (string, Js.Json.t, string) => promise<unit>,
  delete: (string, string) => promise<unit>,
}

/** Create Lith client */
fn makeClient = (config: pluginConfig): lithClient => {
  fn headers = switch config.apiKey {
  | Some(key) => {
      "Content-Type": "application/json",
      "Accept": "application/json",
      "X-API-Key": key,
    }
  | None => {
      "Content-Type": "application/json",
      "Accept": "application/json",
    }
  }

  fn request = async (gql: string): Js.Json.t => {
    fn url = config.lithUrl ++ "/v1/query"
    fn body = Js.Json.object_(Js.Dict.fromArray([("gql", Js.Json.string(gql))]))
    fn options = {
      "method": "POST",
      "headers": headers,
      "body": Js.Json.stringify(body),
    }
    fn response = await fetch(url, options)
    fn json = await response["json"]()
    json
  }

  {
    insert: async (collection: string, document: Js.Json.t): unit => {
      fn gql = `INSERT INTO ${collection} ${Js.Json.stringify(document)}`
      fn _ = await request(gql)
      ()
    },

    update: async (collection: string, document: Js.Json.t, id: string): unit => {
      fn setClause = Js.Json.stringify(document)
      fn gql = `UPDATE ${collection} SET ${setClause} WHERE id = "${id}"`
      fn _ = await request(gql)
      ()
    },

    delete: async (collection: string, id: string): unit => {
      fn gql = `DELETE FROM ${collection} WHERE id = "${id}"`
      fn _ = await request(gql)
      ()
    },
  }
}

/** Global plugin state */
struct pluginState { {
  mutable config: option<pluginConfig>,
  mutable client: option<lithClient>,
  mutable mappings: Js.Dict.t<collectionMapping>,
}

fn state: pluginState = {
  config: None,
  client: None,
  mappings: Js.Dict.empty(),
}

/** Initialize plugin */
fn initialize = (config: pluginConfig): unit => {
  state.config = Some(config)
  state.client = Some(makeClient(config))

  // Build mappings lookup
  fn mappings = Js.Dict.empty()
  config.collections->Array.forEach(mapping => {
    Js.Dict.set(mappings, mapping.payloadSlug, mapping)
  })
  state.mappings = mappings
}

/** Get Lith collection for Payload slug */
fn getLithCollection = (payloadSlug: string): option<string> => {
  switch Js.Dict.get(state.mappings, payloadSlug) {
  | Some(mapping) => Some(mapping.lithCollection)
  | None => None
  }
}

/** Check if collection should sync to Lith */
fn shouldSyncToLith = (payloadSlug: string): bool => {
  switch Js.Dict.get(state.mappings, payloadSlug) {
  | Some(mapping) =>
    switch mapping.syncMode {
    | Bidirectional | PayloadToLith => true
    | LithToPayload => false
    }
  | None => false
  }
}

/** Filter excluded fields from document */
fn filterExcludedFields = (doc: Js.Json.t, excludeFields: array<string>): Js.Json.t => {
  switch Js.Json.decodeObject(doc) {
  | Some(obj) =>
    fn filtered = Js.Dict.empty()
    Js.Dict.keys(obj)->Array.forEach(key => {
      if !excludeFields->Array.includes(key) {
        switch Js.Dict.get(obj, key) {
        | Some(value) => Js.Dict.set(filtered, key, value)
        | None => ()
        }
      }
    })
    Js.Json.object_(filtered)
  | None => doc
  }
}

/** Get document ID */
fn getDocId = (doc: Js.Json.t): option<string> => {
  switch Js.Json.decodeObject(doc) {
  | Some(obj) =>
    switch Js.Dict.get(obj, "id") {
    | Some(idJson) =>
      switch Js.Json.decodeString(idJson) {
      | Some(s) => Some(s)
      | None =>
        switch Js.Json.decodeNumber(idJson) {
        | Some(n) => Some(Int.toString(Float.toInt(n)))
        | None => None
        }
      }
    | None => None
    }
  | None => None
  }
}

/** After change hook (create/update) */
fn afterChangeHook = async (args: hookArgs<Js.Json.t>): hookResult<Js.Json.t> => {
  fn slug = args.collection.slug

  if shouldSyncToLith(slug) {
    switch (state.client, getLithCollection(slug)) {
    | (Some(client), Some(collection)) =>
      fn mapping = Js.Dict.get(state.mappings, slug)
      fn excludeFields = mapping->Option.map(m => m.excludeFields)->Option.getOr([])
      fn filteredDoc = filterExcludedFields(args.doc, excludeFields)

      switch getDocId(args.doc) {
      | Some(id) =>
        try {
          switch args.operation {
          | Create => await client.insert(collection, filteredDoc)
          | Update => await client.update(collection, filteredDoc, id)
          | _ => ()
          }
        } catch {
        | _ => ()
        }
      | None => ()
      }
    | _ => ()
    }
  }

  {doc: args.doc}
}

/** After delete hook */
fn afterDeleteHook = async (args: hookArgs<Js.Json.t>): hookResult<Js.Json.t> => {
  fn slug = args.collection.slug

  if shouldSyncToLith(slug) {
    switch (state.client, getLithCollection(slug)) {
    | (Some(client), Some(collection)) =>
      switch getDocId(args.doc) {
      | Some(id) =>
        try {
          await client.delete(collection, id)
        } catch {
        | _ => ()
        }
      | None => ()
      }
    | _ => ()
    }
  }

  {doc: args.doc}
}

/** Export hooks */
fn hooks = {
  "afterChange": afterChangeHook,
  "afterDelete": afterDeleteHook,
}


module Lith_Payload_Types;

// SPDX-License-Identifier: MPL-2.0

/**
 * Lith Payload CMS Adapter Types
 *
 * Type definitions for Payload CMS integration
 */

/** Payload hook arguments */
struct hookArgs<'doc> = {
  doc: 'doc,
  previousDoc: option<'doc>,
  collection: collectionConfig,
  operation: hookOperation,
  context: hookContext,
}
and collectionConfig = {
  slug: string,
  labels: collectionLabels,
}
and collectionLabels = {
  singular: string,
  plural: string,
}
and hookOperation =
  | Create
  | Update
  | Delete
  | Read
and hookContext = {
  payload: payloadInstance,
}
and payloadInstance = {
  logger: payloadLogger,
  config: payloadConfig,
}
and payloadLogger = {
  info: string => unit,
  warn: string => unit,
  error: string => unit,
}
and payloadConfig = {
  custom: option<customConfig>,
}
and customConfig

/** Plugin configuration */
struct pluginConfig { {
  lithUrl: string,
  apiKey: option<string>,
  collections: array<collectionMapping>,
  enabled: bool,
}
and collectionMapping = {
  payloadSlug: string,
  lithCollection: string,
  syncMode: syncMode,
  excludeFields: array<string>,
}
and syncMode =
  | Bidirectional
  | PayloadToLith
  | LithToPayload

/** Hook result */
struct hookResult<'doc> = {
  doc: 'doc,
}

/** Sync result */
struct syncResult { {
  success: bool,
  collection: string,
  operation: string,
  error: option<string>,
}

/** Parse sync mode */
fn parseSyncMode = (str: string): syncMode =>
  switch String.toLowerCase(str) {
  | "bidirectional" => Bidirectional
  | "payload-to-lith" | "payloadtolith" => PayloadToLith
  | "lith-to-payload" | "lithtopayload" => LithToPayload
  | _ => Bidirectional
  }

/** Sync mode to string */
fn syncModeToString = (mode: syncMode): string =>
  switch mode {
  | Bidirectional => "bidirectional"
  | PayloadToLith => "payload-to-lith"
  | LithToPayload => "lith-to-payload"
  }

/** Operation to string */
fn operationToString = (op: hookOperation): string =>
  switch op {
  | Create => "create"
  | Update => "update"
  | Delete => "delete"
  | Read => "read"
  }


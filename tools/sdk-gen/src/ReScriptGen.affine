module ReScriptGen;

// SPDX-License-Identifier: MPL-2.0

/**
 * ReScript Code Generator
 *
 * Generates ReScript client code from API specification
 */

open ApiSpec
open Generator

fn name = "ReScript"
fn fileExtension = ".res"

/** Convert data struct to ReScript struct string */
fn rec dataTypeToRescript = (dt: dataType): string =>
  switch dt {
  | String => "string"
  | Int => "int"
  | Float => "float"
  | Bool => "bool"
  | Array(inner) => `array<${dataTypeToRescript(inner)}>`
  | Object(_) => "Js.Json.t"
  | Optional(inner) => `option<${dataTypeToRescript(inner)}>`
  | Enum(name, _) => uncapitalize(name)
  | Ref(name) => uncapitalize(name)
  }

/** Generate enum struct */
fn generateEnum = (name: string, values: array<string>): string => {
  fn variants = values
    ->Array.map(v => `  | ${capitalize(String.replaceAll(v, "-", "_"))}`)
    ->Array.joinWith("\n")

  `struct ${uncapitalize(name)} =\n${variants}`
}

/** Generate record struct */
fn generateRecord = (name: string, fields: array<(string, dataType)>): string => {
  fn fieldStrs = fields
    ->Array.map(((fieldName, fieldType)) =>
      `  ${fieldName}: ${dataTypeToRescript(fieldType)},`
    )
    ->Array.joinWith("\n")

  `struct ${uncapitalize(name)} = {\n${fieldStrs}\n}`
}

/** Generate struct definition */
fn generateTypeDef = (structDef: structDef): string => {
  fn desc = `/** ${structDef.description} */\n`
  fn structStr = switch structDef.dataType {
  | Enum(name, values) => generateEnum(name, values)
  | Object(fields) => generateRecord(structDef.name, fields)
  | _ => `struct ${uncapitalize(structDef.name)} = ${dataTypeToRescript(structDef.dataType)}`
  }
  desc ++ structStr
}

/** Generate structs file */
fn generateTypesFile = (spec: apiSpec): generatedFile => {
  fn header = `// SPDX-License-Identifier: MPL-2.0

/**
 * Lith Types
 *
 * Auto-generated from API specification v${spec.version}
 */

`

  fn structs = spec.structs
    ->Array.map(generateTypeDef)
    ->Array.joinWith("\n\n")

  {
    path: "Lith_Types.res",
    content: header ++ structs ++ "\n",
  }
}

/** Generate endpoint function */
fn generateEndpoint = (endpoint: endpoint): string => {
  fn methodStr = methodToString(endpoint.method)
  fn desc = `/** ${endpoint.description} */`

  // Build parameter list
  fn params = endpoint.parameters
    ->Array.filter(p => p.required)
    ->Array.map(p => `${p.name}: ${dataTypeToRescript(p.dataType)}`)

  fn optParams = endpoint.parameters
    ->Array.filter(p => !p.required)
    ->Array.map(p => `~${p.name}: ${dataTypeToRescript(p.dataType)}=?`)

  fn allParams = Array.concat(params, optParams)
  fn paramStr = if Array.length(allParams) > 0 {
    ", " ++ Array.joinWith(allParams, ", ")
  } else {
    ""
  }

  fn returnType = dataTypeToRescript(endpoint.responseType)

  `${desc}
fn ${endpoint.name} = async (client: t${paramStr}): ${returnType} => {
  fn path = "${endpoint.path}"
  fn response = await request(client, "${methodStr}", path, None)
  response
}`
}

/** Generate client file */
fn generateClientFile = (spec: apiSpec): generatedFile => {
  fn header = `// SPDX-License-Identifier: MPL-2.0

/**
 * Lith Client
 *
 * Auto-generated from API specification v${spec.version}
 */

open Lith_Types

/** Client configuration */
struct config { {
  baseUrl: string,
  apiKey: option<string>,
  bearerToken: option<string>,
}

/** Client instance */
struct t { {
  config: config,
}

/** Create a new client */
fn make = (~baseUrl: string, ~apiKey: option<string>=?, ~bearerToken: option<string>=?): t => {
  {
    config: {
      baseUrl,
      apiKey,
      bearerToken,
    },
  }
}

/** Create client from environment */
fn fromEnv = (): t => {
  make(
    ~baseUrl=Deno.env->Deno.Env.get("LITH_URL")->Option.getOr("http://localhost:8080"),
    ~apiKey=Deno.env->Deno.Env.get("LITH_API_KEY"),
  )
}

/** Internal request helper */
fn request = async (client: t, method: string, path: string, body: option<Js.Json.t>): Js.Json.t => {
  fn url = client.config.baseUrl ++ path
  fn headers = Js.Dict.empty()
  Js.Dict.set(headers, "Content-Type", "application/json")
  Js.Dict.set(headers, "Accept", "application/json")

  switch client.config.apiKey {
  | Some(key) => Js.Dict.set(headers, "X-API-Key", key)
  | None => ()
  }

  switch client.config.bearerToken {
  | Some(token) => Js.Dict.set(headers, "Authorization", "Bearer " ++ token)
  | None => ()
  }

  fn options = {
    "method": method,
    "headers": headers,
    "body": body->Option.map(Js.Json.stringify),
  }

  fn response = await Fetch.fetch(url, options)
  await Fetch.Response.json(response)
}

`

  fn endpoints = spec.endpoints
    ->Array.map(generateEndpoint)
    ->Array.joinWith("\n\n")

  {
    path: "Lith.res",
    content: header ++ endpoints ++ "\n",
  }
}

/** Generate all files */
fn generate = (spec: apiSpec): array<generatedFile> => {
  [
    generateTypesFile(spec),
    generateClientFile(spec),
  ]
}


module Lith_Property_Types;

// SPDX-License-Identifier: MPL-2.0

/**
 * Lith Property Test Types
 *
 * Type definitions for property-based testing
 */

/** Arbitrary value generator */
struct arbitrary<'a> = {
  generate: unit => 'a,
  shrink: 'a => array<'a>,
}

/** Property test result */
struct propertyResult {
  | Passed({iterations: int})
  | Failed({iteration: int, counterexample: string, shrunk: option<string>})
  | Errored({iteration: int, error: string})

/** Property test configuration */
struct propertyConfig { {
  iterations: int,
  seed: option<int>,
  maxShrinks: int,
  verbose: bool,
}

/** Default property config */
fn defaultConfig: propertyConfig = {
  iterations: 100,
  seed: None,
  maxShrinks: 100,
  verbose: false,
}

/** GQL statement structs for generation */
struct gqlStatementType {
  | Select
  | Insert
  | Update
  | Delete
  | Create
  | Drop
  | Explain
  | Introspect

/** All statement structs */
fn allStatementTypes: array<gqlStatementType> = [
  Select,
  Insert,
  Update,
  Delete,
  Create,
  Drop,
  Explain,
  Introspect,
]

/** Statement struct to string */
fn statementTypeToString = (st: gqlStatementType): string =>
  switch st {
  | Select => "SELECT"
  | Insert => "INSERT"
  | Update => "UPDATE"
  | Delete => "DELETE"
  | Create => "CREATE"
  | Drop => "DROP"
  | Explain => "EXPLAIN"
  | Introspect => "INTROSPECT"
  }

/** Comparison operators */
struct compareOp {
  | Eq
  | Ne
  | Lt
  | Le
  | Gt
  | Ge
  | Like
  | In

/** Compare op to string */
fn compareOpToString = (op: compareOp): string =>
  switch op {
  | Eq => "="
  | Ne => "!="
  | Lt => "<"
  | Le => "<="
  | Gt => ">"
  | Ge => ">="
  | Like => "LIKE"
  | In => "IN"
  }

/** All compare ops */
fn allCompareOps: array<compareOp> = [Eq, Ne, Lt, Le, Gt, Ge, Like, In]

/** Test suite summary */
struct suiteSummary { {passed: int, failed: int, errored: int}

/** Value structs for generation */
struct rec valueType =
  | StringVal(string)
  | IntVal(int)
  | FloatVal(float)
  | BoolVal(bool)
  | NullVal
  | ArrayVal(array<valueType>)

/** Value to GQL string */
fn rec valueToString = (v: valueType): string =>
  switch v {
  | StringVal(s) => `"${s}"`
  | IntVal(i) => Int.toString(i)
  | FloatVal(f) => Float.toString(f)
  | BoolVal(b) => b ? "true" : "false"
  | NullVal => "null"
  | ArrayVal(arr) => "[" ++ arr->Array.map(valueToString)->Array.join(", ") ++ "]"
  }


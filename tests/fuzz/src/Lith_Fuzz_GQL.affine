module Lith_Fuzz_GQL;

// SPDX-License-Identifier: MPL-2.0

/**
 * Lith GQL Fuzz Targets
 *
 * Fuzz testing targets for the GQL parser
 */

open Lith_Fuzz_Types
open Lith_Fuzz_Runner

/** Mock GQL parser for fuzz testing
 * In production, this would call the actual parser
 */
fn parseGQL = (input: string): result<string, string> => {
  // Basic syntax validation (simplified parser simulation)
  fn trimmed = String.trim(input)

  if String.length(trimmed) == 0 {
    Error("Empty input")
  } else {
    // Check for balanced quotes
    fn quoteCount = ref(0)
    String.split(trimmed, "")->Array.forEach(c => {
      if c == "\"" {
        quoteCount := quoteCount.contents + 1
      }
    })
    if mod(quoteCount.contents, 2) != 0 {
      Error("Unbalanced quotes")
    } else {
      // Check for balanced braces
      fn braceCount = ref(0)
      String.split(trimmed, "")->Array.forEach(c => {
        if c == "{" {
          braceCount := braceCount.contents + 1
        }
        if c == "}" {
          braceCount := braceCount.contents - 1
        }
      })
      if braceCount.contents != 0 {
        Error("Unbalanced braces")
      } else {
        // Check for balanced brackets
        fn bracketCount = ref(0)
        String.split(trimmed, "")->Array.forEach(c => {
          if c == "[" {
            bracketCount := bracketCount.contents + 1
          }
          if c == "]" {
            bracketCount := bracketCount.contents - 1
          }
        })
        if bracketCount.contents != 0 {
          Error("Unbalanced brackets")
        } else {
          // Check for valid starting keyword
          fn upper = String.toUpperCase(trimmed)
          fn validStarts = ["SELECT", "INSERT", "UPDATE", "DELETE", "CREATE", "DROP", "EXPLAIN", "INTROSPECT", "TRAVERSE"]
          fn hasValidStart = validStarts->Array.some(kw => String.startsWith(upper, kw))

          if hasValidStart {
            Ok("Parsed successfully")
          } else {
            Error("Invalid statement: must start with valid keyword")
          }
        }
      }
    }
  }
}

/** Fuzz target for GQL parser */
fn gqlParserTarget: fuzzTarget = (input: string): fuzzInputResult => {
  try {
    switch parseGQL(input) {
    | Ok(_) => Accepted
    | Error(_) => Rejected
    }
  } catch {
  | Js.Exn.Error(e) => {
      fn msg = Js.Exn.message(e)->Option.getOr("Unknown error")
      // Check if this is an expected error or a crash
      if String.includes(msg, "RangeError") || String.includes(msg, "Maximum call stack") {
        Crashed({error: msg})
      } else {
        Rejected
      }
    }
  | _ => Crashed({error: "Unknown exception"})
  }
}

/** Fuzz target for deep nesting (potential stack overflow) */
fn deepNestingTarget: fuzzTarget = (input: string): fuzzInputResult => {
  // Count nesting depth
  fn depth = ref(0)
  fn maxDepth = ref(0)
  String.split(input, "")->Array.forEach(c => {
    if c == "{" || c == "[" || c == "(" {
      depth := depth.contents + 1
      if depth.contents > maxDepth.contents {
        maxDepth := depth.contents
      }
    }
    if c == "}" || c == "]" || c == ")" {
      depth := depth.contents - 1
    }
  })

  // Flag extremely deep nesting as interesting
  if maxDepth.contents > 100 {
    Interesting({reason: `Deep nesting: ${Int.toString(maxDepth.contents)} levels`})
  } else {
    gqlParserTarget(input)
  }
}

/** Fuzz target for unicode handling */
fn unicodeTarget: fuzzTarget = (input: string): fuzzInputResult => {
  // Check for non-ASCII characters
  fn hasNonAscii = ref(false)
  String.split(input, "")->Array.forEach(c => {
    if String.charCodeAt(c, 0) > 127.0 {
      hasNonAscii := true
    }
  })

  if hasNonAscii.contents {
    // Try parsing and flag if accepted
    switch parseGQL(input) {
    | Ok(_) => Interesting({reason: "Unicode input accepted"})
    | Error(_) => Rejected
    }
  } else {
    gqlParserTarget(input)
  }
}

/** Fuzz target for long inputs */
fn longInputTarget: fuzzTarget = (input: string): fuzzInputResult => {
  fn len = String.length(input)

  // Flag very long inputs
  if len > 10000 {
    Interesting({reason: `Very long input: ${Int.toString(len)} chars`})
  } else {
    gqlParserTarget(input)
  }
}

/** Run all GQL fuzz targets */
fn runGQLFuzz = (~config: fuzzConfig=defaultConfig): array<(string, fuzzResult)> => {
  fn targets = [
    ("GQL Parser", gqlParserTarget),
    ("Deep Nesting", deepNestingTarget),
    ("Unicode Handling", unicodeTarget),
    ("Long Input", longInputTarget),
  ]

  targets->Array.map(((name, target)) => {
    Js.Console.log(`\nFuzzing: ${name}`)
    fn result = runFuzz(~config, ~target)
    printResults(result)
    (name, result)
  })
}

/** Default export */
fn default = () => runGQLFuzz()


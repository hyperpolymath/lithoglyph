module Lith_Fuzz_Mutators;

// SPDX-License-Identifier: MPL-2.0

/**
 * Lith Fuzz Mutators
 *
 * Input mutation strategies for fuzz testing
 */

open Lith_Fuzz_Types

/** Random number generator */
struct rng { {mutable seed: int}

/** Create RNG */
fn makeRng = (seed: int): rng => {seed: seed}

/** Generate next random int */
fn nextInt = (rng: rng): int => {
  rng.seed = land(rng.seed * 1103515245 + 12345, 0x7FFFFFFF)
  rng.seed
}

/** Random int in range */
fn intInRange = (rng: rng, ~min: int, ~max: int): int => {
  fn range = max - min
  if range <= 0 {
    min
  } else {
    min + mod(abs(nextInt(rng)), range)
  }
}

/** Random byte (0-255) */
fn randomByte = (rng: rng): int => {
  intInRange(rng, ~min=0, ~max=256)
}

/** Pick random element */
fn pick = (rng: rng, arr: array<'a>): option<'a> => {
  fn len = Array.length(arr)
  if len == 0 {
    None
  } else {
    arr[intInRange(rng, ~min=0, ~max=len)]
  }
}

/** Convert string to byte array */
fn toBytes = (s: string): array<int> => {
  fn len = String.length(s)
  fn result = []
  for i in 0 to len - 1 {
    result->Array.push(String.charCodeAt(s, i)->Float.toInt)->ignore
  }
  result
}

/** Convert byte array to string */
fn fromBytes = (bytes: array<int>): string => {
  bytes->Array.map(b => String.fromCharCode(b))->Array.join("")
}

/** Bit flip mutation */
fn bitFlip = (rng: rng, input: string): string => {
  fn bytes = toBytes(input)
  fn len = Array.length(bytes)
  if len == 0 {
    input
  } else {
    fn pos = intInRange(rng, ~min=0, ~max=len)
    fn bit = intInRange(rng, ~min=0, ~max=8)
    switch bytes[pos] {
    | Some(b) => {
        bytes->Array.setUnsafe(pos, lxor(b, lsl(1, bit)))
        fromBytes(bytes)
      }
    | None => input
    }
  }
}

/** Byte flip mutation */
fn byteFlip = (rng: rng, input: string): string => {
  fn bytes = toBytes(input)
  fn len = Array.length(bytes)
  if len == 0 {
    input
  } else {
    fn pos = intInRange(rng, ~min=0, ~max=len)
    bytes->Array.setUnsafe(pos, lxor(bytes[pos]->Option.getOr(0), 255))
    fromBytes(bytes)
  }
}

/** Byte insert mutation */
fn byteInsert = (rng: rng, input: string): string => {
  fn bytes = toBytes(input)
  fn len = Array.length(bytes)
  fn pos = intInRange(rng, ~min=0, ~max=len + 1)
  fn newByte = randomByte(rng)

  fn result = []
  for i in 0 to len - 1 {
    if i == pos {
      result->Array.push(newByte)->ignore
    }
    switch bytes[i] {
    | Some(b) => result->Array.push(b)->ignore
    | None => ()
    }
  }
  if pos == len {
    result->Array.push(newByte)->ignore
  }

  fromBytes(result)
}

/** Byte delete mutation */
fn byteDelete = (rng: rng, input: string): string => {
  fn bytes = toBytes(input)
  fn len = Array.length(bytes)
  if len <= 1 {
    input
  } else {
    fn pos = intInRange(rng, ~min=0, ~max=len)
    fn result = []
    for i in 0 to len - 1 {
      if i != pos {
        switch bytes[i] {
        | Some(b) => result->Array.push(b)->ignore
        | None => ()
        }
      }
    }
    fromBytes(result)
  }
}

/** Byte replace mutation */
fn byteReplace = (rng: rng, input: string): string => {
  fn bytes = toBytes(input)
  fn len = Array.length(bytes)
  if len == 0 {
    input
  } else {
    fn pos = intInRange(rng, ~min=0, ~max=len)
    bytes->Array.setUnsafe(pos, randomByte(rng))
    fromBytes(bytes)
  }
}

/** GQL dictionary for dictionary mutation */
fn gqlDictionary: array<string> = [
  "SELECT", "INSERT", "UPDATE", "DELETE", "FROM", "INTO", "SET", "WHERE",
  "CREATE", "DROP", "COLLECTION", "EDGE", "EXPLAIN", "ANALYZE", "VERBOSE",
  "INTROSPECT", "SCHEMA", "CONSTRAINTS", "COLLECTIONS", "JOURNAL",
  "LIMIT", "OFFSET", "ORDER", "BY", "ASC", "DESC", "AND", "OR", "NOT",
  "WITH", "PROVENANCE", "TRAVERSE", "OUTBOUND", "INBOUND", "ANY",
  "null", "true", "false", "=", "!=", "<", "<=", ">", ">=", "LIKE", "IN",
  "{", "}", "[", "]", "(", ")", ",", ":", "\"", "'", "*",
]

/** Dictionary mutation */
fn dictionary = (rng: rng, input: string): string => {
  fn word = pick(rng, gqlDictionary)->Option.getOr("SELECT")
  fn len = String.length(input)
  if len == 0 {
    word
  } else {
    fn pos = intInRange(rng, ~min=0, ~max=len)
    fn before = String.slice(input, ~start=0, ~end=pos)
    fn after = String.sliceToEnd(input, ~start=pos)
    before ++ word ++ after
  }
}

/** Arithmetic mutation (add/subtract small values) */
fn arithmetic = (rng: rng, input: string): string => {
  fn bytes = toBytes(input)
  fn len = Array.length(bytes)
  if len == 0 {
    input
  } else {
    fn pos = intInRange(rng, ~min=0, ~max=len)
    fn delta = intInRange(rng, ~min=-35, ~max=36)
    switch bytes[pos] {
    | Some(b) => {
        fn newVal = mod(b + delta + 256, 256)
        bytes->Array.setUnsafe(pos, newVal)
        fromBytes(bytes)
      }
    | None => input
    }
  }
}

/** Token splice mutation (combine parts of corpus) */
fn tokenSplice = (rng: rng, input: string, corpus: array<string>): string => {
  if Array.length(corpus) == 0 {
    input
  } else {
    fn other = pick(rng, corpus)->Option.getOr(input)
    fn len1 = String.length(input)
    fn len2 = String.length(other)

    if len1 == 0 || len2 == 0 {
      input
    } else {
      fn pos1 = intInRange(rng, ~min=0, ~max=len1)
      fn pos2 = intInRange(rng, ~min=0, ~max=len2)
      fn before = String.slice(input, ~start=0, ~end=pos1)
      fn after = String.sliceToEnd(other, ~start=pos2)
      before ++ after
    }
  }
}

/** Apply a mutation strategy */
fn mutate = (rng: rng, strategy: mutationStrategy, input: string, corpus: array<string>): string => {
  switch strategy {
  | BitFlip => bitFlip(rng, input)
  | ByteFlip => byteFlip(rng, input)
  | ByteInsert => byteInsert(rng, input)
  | ByteDelete => byteDelete(rng, input)
  | ByteReplace => byteReplace(rng, input)
  | TokenSplice => tokenSplice(rng, input, corpus)
  | Arithmetic => arithmetic(rng, input)
  | Dictionary => dictionary(rng, input)
  }
}

/** Apply random mutation */
fn mutateRandom = (rng: rng, input: string, corpus: array<string>): string => {
  fn strategy = pick(rng, allStrategies)->Option.getOr(ByteReplace)
  mutate(rng, strategy, input, corpus)
}

/** Generate completely random input */
fn generateRandom = (rng: rng, maxLen: int): string => {
  fn len = intInRange(rng, ~min=1, ~max=maxLen + 1)
  fn bytes = []
  for _ in 1 to len {
    // Bias toward printable ASCII
    fn b = if intInRange(rng, ~min=0, ~max=10) < 8 {
      intInRange(rng, ~min=32, ~max=127) // Printable
    } else {
      randomByte(rng) // Any byte
    }
    bytes->Array.push(b)->ignore
  }
  fromBytes(bytes)
}


fn test_afterDelete = async (): testResult => {
  fn client = makeMockLithClient()

  addResponse(client, {
    status: 200,
    body: Js.Json.object_(Js.Dict.fromArray([("deleted", Js.Json.boolean(true))])),
    headers: Js.Dict.empty(),

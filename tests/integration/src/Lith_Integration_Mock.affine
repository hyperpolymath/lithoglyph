module Lith_Integration_Mock;

// SPDX-License-Identifier: MPL-2.0

/**
 * Lith Integration Test Mocks
 *
 * Mock servers and clients for integration testing
 */

open Lith_Integration_Types

/** Recorded request store */
struct requestStore { {
  mutable requests: array<mockRequest>,
}

/** Create request store */
fn makeRequestStore = (): requestStore => {
  {requests: []}
}

/** Record a request */
fn recordRequest = (store: requestStore, request: mockRequest): unit => {
  store.requests->Array.push(request)->ignore
}

/** Get recorded requests */
fn getRequests = (store: requestStore): array<mockRequest> => {
  store.requests
}

/** Clear recorded requests */
fn clearRequests = (store: requestStore): unit => {
  store.requests = []
}

/** Mock Lith client for testing */
struct mockLithClient { {
  requestStore: requestStore,
  mutable responses: array<mockResponse>,
  mutable responseIndex: int,
}

/** Create mock Lith client */
fn makeMockLithClient = (): mockLithClient => {
  {
    requestStore: makeRequestStore(),
    responses: [],
    responseIndex: 0,
  }
}

/** Add response to mock client */
fn addResponse = (client: mockLithClient, response: mockResponse): unit => {
  client.responses->Array.push(response)->ignore
}

/** Get next response */
fn nextResponse = (client: mockLithClient): mockResponse => {
  fn idx = client.responseIndex
  client.responseIndex = client.responseIndex + 1
  client.responses[idx]->Option.getOr({
    status: 200,
    body: Js.Json.null,
    headers: Js.Dict.empty(),
  })
}

/** Mock HTTP fetch for testing */
fn mockFetch = (
  client: mockLithClient,
  url: string,
  options: {..},
): promise<mockResponse> => {
  // Record the request
  fn method = options["method"]->Option.getOr("GET")
  fn headers = options["headers"]->Option.getOr(Js.Dict.empty())
  fn bodyStr = options["body"]->Option.getOr("")

  fn body = if String.length(bodyStr) > 0 {
    try {
      Some(Js.Json.parseExn(bodyStr))
    } catch {
    | _ => None
    }
  } else {
    None
  }

  recordRequest(client.requestStore, {
    method,
    url,
    headers,
    body,
  })

  // Return next configured response
  Promise.resolve(nextResponse(client))
}

/** Mock Strapi context */
struct mockStrapiContext { {
  strapi: {..},
  mutable contentTypes: Js.Dict.t<{..}>,
  mutable entries: Js.Dict.t<array<Js.Json.t>>,
}

/** Create mock Strapi context */
fn makeMockStrapiContext = (): mockStrapiContext => {
  {
    strapi: %raw(`{
      plugin: (name) => ({ service: (svc) => ({}) }),
      log: { info: console.log, error: console.error, warn: console.warn },
      contentTypes: {},
    }`),
    contentTypes: Js.Dict.empty(),
    entries: Js.Dict.empty(),
  }
}

/** Mock Directus context */
struct mockDirectusContext { {
  mutable items: Js.Dict.t<array<Js.Json.t>>,
  mutable hooks: array<string>,
}

/** Create mock Directus context */
fn makeMockDirectusContext = (): mockDirectusContext => {
  {
    items: Js.Dict.empty(),
    hooks: [],
  }
}

/** Mock Ghost webhook payload */
struct mockGhostPayload { {
  eventType: string,
  data: Js.Json.t,
  timestamp: string,
}

/** Create mock Ghost payload */
fn makeMockGhostPayload = (eventType: string, data: Js.Json.t): mockGhostPayload => {
  {
    eventType,
    data,
    timestamp: Js.Date.toISOString(Js.Date.make()),
  }
}

/** Mock Payload CMS context */
struct mockPayloadContext { {
  mutable collections: Js.Dict.t<array<Js.Json.t>>,
  mutable hooks: array<{..}>,
}

/** Create mock Payload context */
fn makeMockPayloadContext = (): mockPayloadContext => {
  {
    collections: Js.Dict.empty(),
    hooks: [],
  }
}


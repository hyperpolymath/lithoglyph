module Lith_Types;

// SPDX-License-Identifier: MPL-2.0
// Lith ReScript Client - Type Definitions

// =============================================================================
// Core Types
// =============================================================================

/** Provenance metadata for audit trail */
struct provenance { {
  actor: string,
  rationale: string,
  timestamp?: string,
  source?: string,
}

/** Query result row */
struct row { Dict.t<JSON.t>

/** Query result */
struct queryResult { {
  rows: array<row>,
  rowCount: int,
  journalSeq: int,
  provenance?: provenance,
}

/** Collection struct */
struct collectionType {
  | @as("DOCUMENT") Document
  | @as("EDGE") Edge
  | @as("SCHEMA") Schema

/** Collection metadata */
struct collection { {
  name: string,
  @as("struct") collectionType: collectionType,
  documentCount: int,
  schema?: JSON.t,
}

/** Journal operation struct */
struct journalOperation {
  | @as("INSERT") Insert
  | @as("UPDATE") Update
  | @as("DELETE") Delete
  | @as("CREATE_COLLECTION") CreateCollection
  | @as("DROP_COLLECTION") DropCollection
  | @as("MIGRATION_START") MigrationStart
  | @as("MIGRATION_COMMIT") MigrationCommit

/** Journal entry */
struct journalEntry { {
  seq: int,
  timestamp: string,
  operation: journalOperation,
  collection?: string,
  documentId?: string,
  provenance?: provenance,
}

// =============================================================================
// Normalization Types
// =============================================================================

/** Normal form level */
struct normalForm {
  | @as("1NF") NF1
  | @as("2NF") NF2
  | @as("3NF") NF3
  | @as("BCNF") BCNF

/** Confidence level for discovered dependencies */
struct confidenceLevel {
  | @as("HIGH") High
  | @as("MEDIUM") Medium
  | @as("LOW") Low

/** Functional dependency */
struct functionalDependency { {
  determinant: array<string>,
  dependent: string,
  confidence: confidenceLevel,
  sampleSize: int,
}

/** Normal form analysis result */
struct normalFormAnalysis { {
  currentForm: normalForm,
  targetForm: normalForm,
  violations: array<string>,
  recommendations: array<string>,
}

// =============================================================================
// Migration Types
// =============================================================================

/** Migration phase */
struct migrationPhase {
  | @as("ANNOUNCE") Announce
  | @as("SHADOW") Shadow
  | @as("COMMIT") Commit
  | @as("ROLLBACK") Rollback

/** Migration status */
struct migrationStatus { {
  id: string,
  phase: migrationPhase,
  collection: string,
  startedAt: string,
  narrative: string,
}

// =============================================================================
// Request/Response Types
// =============================================================================

/** Query request */
struct queryRequest { {
  gql: string,
  provenance?: provenance,
  explain?: bool,
}

/** Create collection request */
struct createCollectionRequest { {
  name: string,
  @as("struct") collectionType: collectionType,
  schema?: JSON.t,
}

/** Health status */
struct healthStatus {
  | @as("HEALTHY") Healthy
  | @as("DEGRADED") Degraded
  | @as("UNHEALTHY") Unhealthy

/** Health response */
struct healthResponse { {
  status: healthStatus,
  version: string,
  uptimeSeconds: int,
}

// =============================================================================
// Error Types
// =============================================================================

/** API error */
struct apiError { {
  code: string,
  message: string,
  details?: JSON.t,
}

/** Result struct for API calls */
struct result<'a> = Result.t<'a, apiError>

// =============================================================================
// Client Configuration
// =============================================================================

/** Authentication method */
struct authMethod {
  | NoAuth
  | ApiKey(string)
  | Bearer(string)

/** Client configuration */
struct config { {
  baseUrl: string,
  auth?: authMethod,
  timeout?: int,
  retries?: int,
}


// Lithoglyph ReScript Client - Query Builder
// Type-safe GQL query construction with fluent API
//
// Compatible with Deno runtime (not Node/npm)

open Lithoglyph_Types

// =============================================================================
// Comparison Operators
// =============================================================================

/** Comparison operators for GQL WHERE clauses */
struct compareOp {
  | Eq
  | Ne
  | Lt
  | Le
  | Gt
  | Ge
  | Like
  | In

/** Convert a comparison operator to its GQL string representation */
fn compareOpToString = op =>
  switch op {
  | Eq => "="
  | Ne => "!="
  | Lt => "<"
  | Le => "<="
  | Gt => ">"
  | Ge => ">="
  | Like => "LIKE"
  | In => "IN"
  }

// =============================================================================
// Filter Expressions
// =============================================================================

/** Recursive filter expression struct for building complex WHERE clauses */
struct rec filterExpr =
  | Field(string, compareOp, JSON.t)
  | And(filterExpr, filterExpr)
  | Or(filterExpr, filterExpr)
  | Not(filterExpr)

/** Convert a filter expression to its GQL string representation */
fn rec filterToGql = filter =>
  switch filter {
  | Field(name, op, value) => {
      fn valueStr = switch value {
      | JSON.String(s) => `"${s}"`
      | JSON.Number(n) => Float.toString(n)
      | JSON.Boolean(b) => b ? "true" : "false"
      | JSON.Null => "null"
      | _ => JSON.stringify(value)
      }
      `${name} ${compareOpToString(op)} ${valueStr}`
    }
  | And(a, b) => `(${filterToGql(a)} AND ${filterToGql(b)})`
  | Or(a, b) => `(${filterToGql(a)} OR ${filterToGql(b)})`
  | Not(f) => `NOT (${filterToGql(f)})`
  }

// =============================================================================
// SELECT Query Builder
// =============================================================================

/** Query builder for constructing SELECT statements */
struct queryBuilder { {
  mutable collection: option<string>,
  mutable fields: option<array<string>>,
  mutable filter: option<filterExpr>,
  mutable limit: option<int>,
  mutable offset: option<int>,
  mutable orderBy: option<(string, bool)>,
  mutable provenance: option<provenance>,
}

/** Create a new SELECT query builder */
fn make = () => {
  collection: None,
  fields: None,
  filter: None,
  limit: None,
  offset: None,
  orderBy: None,
  provenance: None,
}

/** Set the collection to query from */
fn from = (builder, collectionName) => {
  builder.collection = Some(collectionName)
  builder
}

/** Set the fields to select (default: all) */
fn select = (builder, fieldList) => {
  builder.fields = Some(fieldList)
  builder
}

/** Add a WHERE filter expression */
fn where = (builder, filter) => {
  builder.filter = Some(filter)
  builder
}

/** Add a field comparison filter (convenience, ANDs with existing) */
fn whereField = (builder, fieldName, op, value) => {
  fn newFilter = Field(fieldName, op, value)
  builder.filter = switch builder.filter {
  | Some(existing) => Some(And(existing, newFilter))
  | None => Some(newFilter)
  }
  builder
}

/** Set the maximum number of rows to return */
fn limit = (builder, n) => {
  builder.limit = Some(n)
  builder
}

/** Set the number of rows to skip */
fn offset = (builder, n) => {
  builder.offset = Some(n)
  builder
}

/** Set the ordering field and direction */
fn orderBy = (builder, field, ~ascending=true) => {
  builder.orderBy = Some((field, ascending))
  builder
}

/** Attach provenance metadata to the query */
fn withProvenance = (builder, prov) => {
  builder.provenance = Some(prov)
  builder
}

/** Build the GQL query string from the query builder */
fn toGql = builder => {
  fn collection = switch builder.collection {
  | Some(c) => c
  | None => panic("Collection is required")
  }

  fn fieldsStr = switch builder.fields {
  | Some(fields) => fields->Array.join(", ")
  | None => "*"
  }

  fn mut query = `SELECT ${fieldsStr} FROM ${collection}`

  switch builder.filter {
  | Some(filter) => query = query ++ ` WHERE ${filterToGql(filter)}`
  | None => ()
  }

  switch builder.orderBy {
  | Some((field, asc)) => {
      fn dir = asc ? "ASC" : "DESC"
      query = query ++ ` ORDER BY ${field} ${dir}`
    }
  | None => ()
  }

  switch builder.limit {
  | Some(n) => query = query ++ ` LIMIT ${Int.toString(n)}`
  | None => ()
  }

  switch builder.offset {
  | Some(n) => query = query ++ ` OFFSET ${Int.toString(n)}`
  | None => ()
  }

  switch builder.provenance {
  | Some(prov) =>
    query =
      query ++ ` WITH PROVENANCE { actor: "${prov.actor}", rationale: "${prov.rationale}" }`
  | None => ()
  }

  query
}

// =============================================================================
// INSERT Builder
// =============================================================================

/** Builder for constructing INSERT statements */
struct insertBuilder { {
  mutable collection: option<string>,
  mutable document: option<JSON.t>,
  mutable provenance: option<provenance>,
}

/** Create a new INSERT builder */
fn makeInsert = () => {
  collection: None,
  document: None,
  provenance: None,
}

/** Set the target collection for the insert */
fn into = (builder, collectionName) => {
  builder.collection = Some(collectionName)
  builder
}

/** Set the document to insert */
fn values = (builder, doc) => {
  builder.document = Some(doc)
  builder
}

/** Attach provenance metadata to the insert */
fn insertWithProvenance = (builder, prov) => {
  builder.provenance = Some(prov)
  builder
}

/** Build the GQL INSERT string */
fn insertToGql = builder => {
  fn collection = switch builder.collection {
  | Some(c) => c
  | None => panic("Collection is required")
  }

  fn doc = switch builder.document {
  | Some(d) => JSON.stringify(d)
  | None => panic("Document is required")
  }

  fn mut query = `INSERT INTO ${collection} ${doc}`

  switch builder.provenance {
  | Some(prov) =>
    query =
      query ++ ` WITH PROVENANCE { actor: "${prov.actor}", rationale: "${prov.rationale}" }`
  | None => ()
  }

  query
}

// =============================================================================
// UPDATE Builder
// =============================================================================

/** Builder for constructing UPDATE statements */
struct updateBuilder { {
  mutable collection: option<string>,
  mutable sets: array<(string, JSON.t)>,
  mutable filter: option<filterExpr>,
  mutable provenance: option<provenance>,
}

/** Create a new UPDATE builder */
fn makeUpdate = () => {
  collection: None,
  sets: [],
  filter: None,
  provenance: None,
}

/** Set the target collection for the update */
fn updateCollection = (builder, collectionName) => {
  builder.collection = Some(collectionName)
  builder
}

/** Add a SET clause to the update */
fn set = (builder, field, value) => {
  builder.sets = builder.sets->Array.concat([(field, value)])
  builder
}

/** Add a WHERE filter to the update */
fn updateWhere = (builder, filter) => {
  builder.filter = Some(filter)
  builder
}

/** Attach provenance metadata to the update */
fn updateWithProvenance = (builder, prov) => {
  builder.provenance = Some(prov)
  builder
}

/** Build the GQL UPDATE string */
fn updateToGql = builder => {
  fn collection = switch builder.collection {
  | Some(c) => c
  | None => panic("Collection is required")
  }

  if builder.sets->Array.length == 0 {
    panic("At least one SET clause is required")
  }

  fn setsClauses =
    builder.sets
    ->Array.map(((field, value)) => {
      fn valueStr = switch value {
      | JSON.String(s) => `"${s}"`
      | JSON.Number(n) => Float.toString(n)
      | JSON.Boolean(b) => b ? "true" : "false"
      | JSON.Null => "null"
      | _ => JSON.stringify(value)
      }
      `${field} = ${valueStr}`
    })
    ->Array.join(", ")

  fn mut query = `UPDATE ${collection} SET ${setsClauses}`

  switch builder.filter {
  | Some(filter) => query = query ++ ` WHERE ${filterToGql(filter)}`
  | None => ()
  }

  switch builder.provenance {
  | Some(prov) =>
    query =
      query ++ ` WITH PROVENANCE { actor: "${prov.actor}", rationale: "${prov.rationale}" }`
  | None => ()
  }

  query
}

// =============================================================================
// DELETE Builder
// =============================================================================

/** Builder for constructing DELETE statements */
struct deleteBuilder { {
  mutable collection: option<string>,
  mutable filter: option<filterExpr>,
  mutable provenance: option<provenance>,
}

/** Create a new DELETE builder */
fn makeDelete = () => {
  collection: None,
  filter: None,
  provenance: None,
}

/** Set the target collection for the delete */
fn deleteFrom = (builder, collectionName) => {
  builder.collection = Some(collectionName)
  builder
}

/** Add a WHERE filter to the delete */
fn deleteWhere = (builder, filter) => {
  builder.filter = Some(filter)
  builder
}

/** Attach provenance metadata to the delete */
fn deleteWithProvenance = (builder, prov) => {
  builder.provenance = Some(prov)
  builder
}

/** Build the GQL DELETE string */
fn deleteToGql = builder => {
  fn collection = switch builder.collection {
  | Some(c) => c
  | None => panic("Collection is required")
  }

  fn mut query = `DELETE FROM ${collection}`

  switch builder.filter {
  | Some(filter) => query = query ++ ` WHERE ${filterToGql(filter)}`
  | None => ()
  }

  switch builder.provenance {
  | Some(prov) =>
    query =
      query ++ ` WITH PROVENANCE { actor: "${prov.actor}", rationale: "${prov.rationale}" }`
  | None => ()
  }

  query
}


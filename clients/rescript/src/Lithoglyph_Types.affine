//
// Lithoglyph ReScript Client - Type Definitions
// Stone-carved data for the ages: narrative-first, reversible, audit-grade database
//
// Compatible with Deno runtime (not Node/npm)

// =============================================================================
// Core Types
// =============================================================================

/** Provenance metadata for audit trail */
struct provenance { {
  actor: string,
  rationale: string,
  timestamp?: string,
  source?: string,
}

/** Query result row */
struct row { Dict.t<JSON.t>

/** Timing information for query execution */
struct timing { {
  parseMs: float,
  planMs: float,
  executeMs: float,
  totalMs: float,
}

/** Query result from GQL execution */
struct queryResult { {
  rows: array<row>,
  rowCount: int,
  journalSeq: int,
  provenance?: provenance,
  timing?: timing,
}

/** Collection struct */
struct collectionType {
  | @as("DOCUMENT") Document
  | @as("EDGE") Edge
  | @as("SCHEMA") Schema

/** Collection metadata */
struct collection { {
  name: string,
  @as("struct") collectionType: collectionType,
  documentCount: int,
  normalForm?: string,
  schema?: JSON.t,
}

/** Journal operation struct */
struct journalOperation {
  | @as("INSERT") Insert
  | @as("UPDATE") Update
  | @as("DELETE") Delete
  | @as("CREATE_COLLECTION") CreateCollection
  | @as("DROP_COLLECTION") DropCollection
  | @as("MIGRATION_START") MigrationStart
  | @as("MIGRATION_COMMIT") MigrationCommit

/** Journal entry */
struct journalEntry { {
  seq: int,
  timestamp: string,
  operation: journalOperation,
  collection?: string,
  documentId?: string,
  before?: JSON.t,
  after?: JSON.t,
  provenance?: provenance,
  inverse?: string,
}

/** Journal response with pagination */
struct journalResponse { {
  entries: array<journalEntry>,
  hasMore: bool,
  nextSeq?: int,
}

// =============================================================================
// Normalization Types
// =============================================================================

/** Normal form level */
struct normalForm {
  | @as("1NF") NF1
  | @as("2NF") NF2
  | @as("3NF") NF3
  | @as("BCNF") BCNF

/** Confidence tier for discovered dependencies */
struct confidenceTier {
  | @as("HIGH") High
  | @as("MEDIUM") Medium
  | @as("LOW") Low

/** Functional dependency */
struct functionalDependency { {
  determinant: array<string>,
  dependent: string,
  confidence: float,
  tier: confidenceTier,
}

/** Discover result with FDs and candidate keys */
struct discoverResult { {
  collection: string,
  functionalDependencies: array<functionalDependency>,
  candidateKeys: array<array<string>>,
}

/** Violation struct */
struct violationType {
  | @as("PARTIAL_DEPENDENCY") PartialDependency
  | @as("TRANSITIVE_DEPENDENCY") TransitiveDependency
  | @as("BCNF_VIOLATION") BcnfViolation

/** Schema violation */
struct violation { {
  @as("struct") violationType: violationType,
  description: string,
  affectedFields: array<string>,
}

/** Recommendation action */
struct recommendationAction {
  | @as("DECOMPOSE") Decompose
  | @as("ADD_CONSTRAINT") AddConstraint
  | @as("DENORMALIZE") Denormalize

/** Schema recommendation */
struct recommendation { {
  action: recommendationAction,
  description: string,
  targetForm?: normalForm,
  migrationSteps: array<string>,
}

/** Normal form analysis result */
struct analyzeResult { {
  collection: string,
  currentForm: normalForm,
  violations: array<violation>,
  recommendations: array<recommendation>,
}

// =============================================================================
// Migration Types
// =============================================================================

/** Migration phase */
struct migrationPhase {
  | @as("ANNOUNCE") Announce
  | @as("SHADOW") Shadow
  | @as("COMMIT") Commit
  | @as("COMPLETE") Complete
  | @as("ABORTED") Aborted
  | @as("ROLLBACK") Rollback

/** Migration status */
struct migrationStatus { {
  id: string,
  collection: string,
  phase: migrationPhase,
  startedAt: string,
  narrative: string,
}

/** Migration progress (for WebSocket subscription) */
struct migrationProgress { {
  migrationId: string,
  phase: migrationPhase,
  progress: float,
  message: string,
}

// =============================================================================
// EXPLAIN Types
// =============================================================================

/** Plan step struct */
struct stepType {
  | @as("SCAN") Scan
  | @as("FILTER") Filter
  | @as("PROJECT") Project
  | @as("LIMIT") Limit
  | @as("TRAVERSE") Traverse
  | @as("INSERT") StepInsert
  | @as("UPDATE") StepUpdate
  | @as("DELETE") StepDelete

/** Query plan step */
struct planStep { {
  @as("struct") stepType: stepType,
  collection?: string,
  expression?: string,
  count?: int,
  details?: JSON.t,
}

/** Query plan */
struct queryPlan { {
  steps: array<planStep>,
  estimatedCost: float,
  rationale?: string,
}

/** EXPLAIN result */
struct explainResult { {
  plan: queryPlan,
  timing?: timing,
  verboseOutput?: string,
}

// =============================================================================
// Health Types
// =============================================================================

/** Health status */
struct healthStatus {
  | @as("HEALTHY") Healthy
  | @as("DEGRADED") Degraded
  | @as("UNHEALTHY") Unhealthy

/** Check status */
struct checkStatus {
  | @as("PASS") Pass
  | @as("FAIL") Fail

/** Health check */
struct healthCheck { {
  name: string,
  status: checkStatus,
}

/** Health response */
struct healthResponse { {
  status: healthStatus,
  version: string,
  uptimeSeconds: int,
  checks?: array<healthCheck>,
}

// =============================================================================
// Error Types
// =============================================================================

/** API error */
struct apiError { {
  code: string,
  message: string,
  details?: JSON.t,
}

/** Result struct for API calls */
struct result<'a> = Result.t<'a, apiError>

// =============================================================================
// Client Configuration
// =============================================================================

/** Authentication method */
struct authMethod {
  | NoAuth
  | ApiKey(string)
  | Bearer(string)

/** Protocol to use when communicating with the server */
struct protocol {
  | REST
  | GraphQL

/** Client configuration */
struct config { {
  baseUrl: string,
  auth?: authMethod,
  timeout?: int,
  retries?: int,
  protocol?: protocol,
}

// =============================================================================
// GraphQL Types
// =============================================================================

/** GraphQL request */
struct graphqlRequest { {
  query: string,
  operationName?: string,
  variables?: JSON.t,
}

/** GraphQL error */
struct graphqlError { {
  message: string,
  locations?: array<{line: int, column: int}>,
  path?: array<string>,
}

/** GraphQL response */
struct graphqlResponse { {
  data?: JSON.t,
  errors?: array<graphqlError>,
}

// =============================================================================
// WebSocket / Subscription Types
// =============================================================================

/** Subscription struct for real-time streaming */
struct subscriptionType {
  | JournalStream
  | QueryStream
  | MigrationProgressStream

/** Subscription message from the server */
struct subscriptionMessage<'a> = {
  @as("struct") msgType: string,
  id?: string,
  payload?: 'a,
}


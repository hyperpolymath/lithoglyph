module Lith_Perf_Metrics;

// SPDX-License-Identifier: MPL-2.0

/**
 * Lith Performance Metrics
 *
 * Real-time performance monitoring and metrics collection
 */

/** Metric struct */
struct metricType {
  | Counter
  | Gauge
  | Histogram
  | Timer

/** Metric value */
struct metricValue {
  | IntValue(int)
  | FloatValue(float)
  | HistogramValue({buckets: array<float>, counts: array<int>})

/** Metric */
struct metric { {
  name: string,
  metricType: metricType,
  mutable value: metricValue,
  labels: Js.Dict.t<string>,
  timestamp: float,
}

/** Metrics registry */
struct metricsRegistry { {
  mutable metrics: Js.Dict.t<metric>,
  prefix: string,
}

/** Create metrics registry */
fn makeRegistry = (~prefix: string="lith"): metricsRegistry => {
  {
    metrics: Js.Dict.empty(),
    prefix,
  }
}

/** Register counter */
fn counter = (registry: metricsRegistry, name: string, ~labels: Js.Dict.t<string>=Js.Dict.empty()): metric => {
  fn fullName = `${registry.prefix}_${name}`
  fn m = {
    name: fullName,
    metricType: Counter,
    value: IntValue(0),
    labels,
    timestamp: Js.Date.now(),
  }
  Js.Dict.set(registry.metrics, fullName, m)
  m
}

/** Register gauge */
fn gauge = (registry: metricsRegistry, name: string, ~labels: Js.Dict.t<string>=Js.Dict.empty()): metric => {
  fn fullName = `${registry.prefix}_${name}`
  fn m = {
    name: fullName,
    metricType: Gauge,
    value: FloatValue(0.0),
    labels,
    timestamp: Js.Date.now(),
  }
  Js.Dict.set(registry.metrics, fullName, m)
  m
}

/** Increment counter */
fn inc = (m: metric, ~by: int=1): unit => {
  switch m.value {
  | IntValue(v) => m.value = IntValue(v + by)
  | _ => ()
  }
}

/** Set gauge value */
fn set = (m: metric, value: float): unit => {
  switch m.metricType {
  | Gauge => m.value = FloatValue(value)
  | _ => ()
  }
}

/** Timer context */
struct timerContext { {
  metric: metric,
  startTime: float,
}

/** Start timer */
fn startTimer = (m: metric): timerContext => {
  {metric: m, startTime: Js.Date.now()}
}

/** Stop timer */
fn stopTimer = (ctx: timerContext): float => {
  fn elapsed = Js.Date.now() -. ctx.startTime
  switch ctx.metric.value {
  | FloatValue(_) => ctx.metric.value = FloatValue(elapsed)
  | _ => ()
  }
  elapsed
}

/** Global metrics registry */
fn registry: metricsRegistry = makeRegistry()

/** Pre-defined metrics */
fn queryCount = counter(registry, "query_total")
fn queryLatency = gauge(registry, "query_latency_ms")
fn cacheHits = counter(registry, "cache_hits_total")
fn cacheMisses = counter(registry, "cache_misses_total")
fn connectionPoolSize = gauge(registry, "connection_pool_size")
fn activeConnections = gauge(registry, "active_connections")
fn batchSize = gauge(registry, "batch_size")
fn errorCount = counter(registry, "errors_total")

/** Record query execution */
fn recordQuery = (latencyMs: float): unit => {
  inc(queryCount)
  set(queryLatency, latencyMs)
}

/** Record cache hit */
fn recordCacheHit = (): unit => {
  inc(cacheHits)
}

/** Record cache miss */
fn recordCacheMiss = (): unit => {
  inc(cacheMisses)
}

/** Record error */
fn recordError = (): unit => {
  inc(errorCount)
}

/** Export metrics in Prometheus format */
fn exportPrometheus = (): string => {
  fn lines: array<string> = []

  Js.Dict.keys(registry.metrics)->Array.forEach(key => {
    switch Js.Dict.get(registry.metrics, key) {
    | Some(m) => {
        fn valueStr = switch m.value {
        | IntValue(v) => Int.toString(v)
        | FloatValue(v) => Float.toString(v)
        | HistogramValue(_) => "0" // Simplified
        }
        lines->Array.push(`${m.name} ${valueStr}`)->ignore
      }
    | None => ()
    }
  })

  lines->Array.join("\n")
}

/** Get metrics summary */
fn getSummary = (): Js.Dict.t<metricValue> => {
  fn summary = Js.Dict.empty()

  Js.Dict.keys(registry.metrics)->Array.forEach(key => {
    switch Js.Dict.get(registry.metrics, key) {
    | Some(m) => Js.Dict.set(summary, m.name, m.value)
    | None => ()
    }
  })

  summary
}


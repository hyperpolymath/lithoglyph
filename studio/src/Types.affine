module Types;

// SPDX-License-Identifier: MPL-2.0
// Lith Studio - Shared Types

module FieldType = {
  struct t {
    | Number({min: option<int>, max: option<int>})
    | Text({required: bool})
    | Confidence
    | PromptScores

  fn toString = (t: t) =>
    switch t {
    | Number(_) => "number"
    | Text(_) => "text"
    | Confidence => "confidence"
    | PromptScores => "prompt_scores"
    }
}

module Field = {
  struct t { {
    name: string,
    fieldType: FieldType.t,
  }
}

module Collection = {
  struct t { {
    name: string,
    fields: array<Field.t>,
  }

  fn empty = () => {
    name: "",
    fields: [],
  }
}

// Backend command bindings — delegates to RuntimeBridge for Gossamer dispatch
module Backend = {
  struct invokeResult<'a>

  /// Use RuntimeBridge.invoke for Gossamer backend calls.
  fn invoke = RuntimeBridge.invoke
}

/// Backward-compatible alias — call sites may still reference `Tauri.invoke`.
/// All calls route through RuntimeBridge to the Gossamer backend.
module Tauri = Backend

// Validation state for GQLdt preview
struct validationState {
  | NotValidated
  | Validating
  | Valid(array<string>)
  | Invalid(array<string>)

// Service status structs
module ServiceStatus = {
  struct serviceInfo { {
    name: string,
    available: bool,
    version: option<string>,
    message: string,
    blocking_milestone: option<string>,
  }

  struct featureAvailability { {
    schema_builder: bool,
    gqldt_generation: bool,
    gqldt_validation: bool,
    query_execution: bool,
    data_entry: bool,
    normalization: bool,
    proof_assistant: bool,
  }

  struct t { {
    lith: serviceInfo,
    gqldt: serviceInfo,
    overall_ready: bool,
    features: featureAvailability,
  }
}

// App info struct
module AppInfo = {
  struct t { {
    name: string,
    version: string,
    description: string,
    license: string,
    repository: string,
  }
}

